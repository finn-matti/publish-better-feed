{
	"name": "obsidian-better-publish-feed",
	"version": "0.1.0",
	"description": "Atom feed of recent changes for Obsidian Publish",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
