{
	"name": "obsidian-better-publish-feed",
	"version": "0.1.0",
	"description": "Atom feed of recent changes for Obsidian Publish",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json CHANGELOG.md",
		"lint": "eslint .",
		"test": "vitest run",
		"prepare": "husky",
		"test:coverage": "vitest run --coverage"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@eslint/js": "^9.39.4",
		"@types/mdast": "^4.0.4",
		"@types/node": "^22.15.17",
		"@vitest/coverage-v8": "^4.1.11",
		"esbuild": "0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@quartz-community/remark-obsidian": "^1.1.0",
		"mdast-util-from-markdown": "^2.1.0",
		"mdast-util-gfm": "^3.1.0",
		"mdast-util-math": "^3.0.0",
		"micromark-extension-gfm": "^3.0.0",
		"micromark-extension-math": "^3.1.0",
		"monkey-around": "^3.0.0",
		"unist-util-visit": "^5.1.0"
	},
	"author": "Martin 'Matti' Hähnel"
}
